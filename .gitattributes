# Store everything with LF, and check it out with LF on every platform.
#
# This matters more here than in the Rust repositories: Gradle's build cache and incremental
# compilation are keyed on file content, so a line-ending change alone can invalidate the whole
# build.
* text=auto eol=lf

# Windows batch files are the one exception: cmd.exe parses them poorly when they use LF,
# which shows up as a wrapper script that fails on a label it cannot find.
*.bat text eol=crlf
*.cmd text eol=crlf

# Binary resources: no end-of-line conversion, no merge attempts.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.webp  binary
*.ico   binary
*.ttf   binary
*.otf   binary
*.jar   binary

# The Gradle wrapper jar is a jar like any other, but it is checked in and must stay byte-exact.
gradle/wrapper/*.jar binary