<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!--
      The camera is what reads a code off another screen. It is asked for when the scanner is
      opened and refused without consequence: the scanner also reads a code out of an image
      the user picks, so a device with no camera, and a user who declines, both keep a way in.
    -->
    <uses-permission android:name="android.permission.CAMERA" />

    <!--
      The local network, which the sync and pairing screens use when both devices are on the
      same WiFi. A channel is opened only while such a screen is showing and says so; nothing
      is announced or listened for in the background.

      INTERNET is what any socket needs, including the UDP one the endpoint is bound to.
      ACCESS_NETWORK_STATE is what the transport reads to follow whether a network is up.
      CHANGE_WIFI_MULTICAST_STATE is what a multicast lock is taken under, and without that
      lock the chipset filters the discovery datagrams out before the system sees them.
    -->
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CHANGE_WIFI_MULTICAST_STATE" />

    <!--
      Asked for from Android 13, which is where the WiFi APIs started to require it. The
      announcement carries a device identifier, an endpoint key and a port, and none of them
      says where the device is, so the permission is declared never to be used for location.
    -->
    <uses-permission
        android:name="android.permission.NEARBY_WIFI_DEVICES"
        android:usesPermissionFlags="neverForLocation" />

    <!--
      Asked for from Android 17, the version that gates every socket to the local network
      behind a permission of its own.
    -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />

    <!--
      Not required: the application works on a device without a camera, which is what the
      manifest asks the store to accept it on.
    -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />

    <!--
      Nothing is backed up and nothing is transferred to another device: the vault is the one
      file this application exists to keep here, and the export the user asks for is the only
      way it should leave. `allowBackup` and `fullBackupContent` are what Android 11 and lower
      read; Android 12 and higher read `dataExtractionRules`.
    -->
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:label="@string/app_name"
        android:supportsRtl="true"
        android:theme="@style/Theme.Qualia2FA">

        <!--
          The activity handles its own configuration changes: the interface is built for a
          window that changes shape, and being recreated on a rotation would throw away the
          vault's in-memory state while the user is reading a code out of it.
        -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboardHidden|density|uiMode"
            android:windowSoftInputMode="adjustResize"
            android:theme="@style/Theme.Qualia2FA">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
    </application>

</manifest>
