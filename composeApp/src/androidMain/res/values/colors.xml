<?xml version="1.0" encoding="utf-8"?>
<!--
  The colors the platform needs before the application is running: the window behind the
  composition, the system bars over it, and the layer of the launcher icon that the mark's
  line work sits on.

  `plate` and `ink` are the **mark's** two tones and have no night variant: the launcher icon
  is drawn in them, and an icon that inverted itself would be a different mark.
  `window_background` is the one that follows the system theme — it is what shows during the
  moment between the launcher and the first frame, and its night variant is in `values-night`.
-->
<resources>
    <color name="plate">#FFEAF2F4</color>
    <color name="ink">#FF091012</color>
    <color name="window_background">@color/plate</color>
    <color name="ic_launcher_background">@color/plate</color>
</resources>
