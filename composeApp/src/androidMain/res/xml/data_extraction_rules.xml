<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android 12 and higher reads instead of `android:allowBackup`: nothing leaves this
  application's private directory, in either a cloud backup or a device transfer. The vault and
  the wrapped master key are exactly what must not travel to a server, and the user has an
  explicit export for the one case where they should.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
