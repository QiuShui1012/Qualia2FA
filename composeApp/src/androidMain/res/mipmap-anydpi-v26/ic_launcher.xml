<?xml version="1.0" encoding="utf-8"?>
<!--
  The layers of the launcher icon. The background is the mark's plate as a flat color, because
  the launcher is the one that shapes it; the foreground holds the mark and is what decides how
  much of the layer the drawing takes up (the numbers live there, next to the paths).

  The monochrome layer is what a themed launcher tints, and it holds the line work alone.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
