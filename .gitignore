# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# The Kotlin compiler's project-local session directory.
.kotlin/

# The SDK path is machine-specific, so it is not committed.
local.properties

# Where the release keystore is and what opens it, when there is a real one to sign with.
# The key itself is never committed, and the patterns are here for the case where it is kept
# beside the repository rather than somewhere only the build knows about.
keystore.properties
*.jks
*.keystore

# The Rust source is materialized from the published crate at build time.
composeApp/rust/
composeApp/target/

# Bytecode the icon converter leaves behind when it is imported rather than run.
__pycache__/

# IDE
.idea/
*.iml

# The IDE draws this file as the project's icon, so it belongs in the repository.
# Everything else in this directory is a local editor setting and stays out: a
# directory-wide ignore would also exclude the icon, because git cannot re-include a
# file whose parent directory is excluded.
.idea/*
!.idea/icon.svg
